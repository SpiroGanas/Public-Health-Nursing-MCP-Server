{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/leadership_fphs_framework.schema.json",
  "title": "FPHS framework, G.L. c. 111 s. 27D, and shared-service options",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "law",
    "framework",
    "shared_services",
    "status_scale",
    "status_scale_note",
    "delivered_by_options",
    "priority_rules",
    "priority_note",
    "not_verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "leadership-fphs-framework"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "law": {
      "type": "object",
      "required": [
        "naming_check",
        "provisions",
        "statute_terms",
        "statute_terms_note"
      ],
      "additionalProperties": false,
      "properties": {
        "naming_check": {
          "type": "string"
        },
        "provisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          }
        },
        "statute_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "fphs_area",
              "own_item"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^STAT-\\d\\d$"
              },
              "kind": {
                "enum": [
                  "capability",
                  "program"
                ]
              },
              "name": {
                "type": "string"
              },
              "fphs_area": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "own_item": {
                "type": "boolean"
              }
            }
          }
        },
        "statute_terms_note": {
          "type": "string"
        }
      }
    },
    "framework": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "community_specific_note",
        "source",
        "areas"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "community_specific_note": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "statute_terms",
              "headline_responsibilities"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d\\d$"
              },
              "kind": {
                "enum": [
                  "capability",
                  "area"
                ]
              },
              "name": {
                "type": "string"
              },
              "statute_terms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "headline_responsibilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^FPHS-\\d\\d\\.\\d\\d$"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "shared_services": {
      "type": "object",
      "required": [
        "intro",
        "models",
        "supports",
        "decision_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "description",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "decision_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status_scale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      }
    },
    "status_scale_note": {
      "type": "string"
    },
    "delivered_by_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "priority_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier",
          "label",
          "rule",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "priority_note": {
      "type": "string"
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
