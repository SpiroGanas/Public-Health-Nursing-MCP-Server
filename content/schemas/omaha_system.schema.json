{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/omaha_system.schema.json",
  "title": "The Omaha System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "sources",
    "license",
    "domains",
    "modifiers",
    "problems",
    "intervention_categories",
    "targets",
    "rating_scale"
  ],
  "$defs": {
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "omaha-system"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "$ref": "#/$defs/cited_text"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "environmental",
              "psychosocial",
              "physiological",
              "health_related_behaviors"
            ]
          },
          "label": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "modifiers": {
      "type": "object",
      "required": [
        "scope",
        "type",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "type": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "$ref": "#/$defs/cited_text"
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "domain",
          "signs_symptoms_verified",
          "signs_symptoms_draft",
          "cues"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "environmental",
              "psychosocial",
              "physiological",
              "health_related_behaviors"
            ]
          },
          "signs_symptoms_verified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signs_symptoms_draft": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 42,
      "maxItems": 42
    },
    "intervention_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "definition",
          "cues"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "cues"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 76,
      "maxItems": 76
    },
    "rating_scale": {
      "type": "object",
      "required": [
        "concepts",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "definition",
              "ratings"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "knowledge",
                  "behavior",
                  "status"
                ]
              },
              "label": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "ratings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "label",
                    "verified"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "label": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    }
                  }
                },
                "minItems": 5,
                "maxItems": 5
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "note": {
          "$ref": "#/$defs/cited_text"
        }
      }
    }
  }
}