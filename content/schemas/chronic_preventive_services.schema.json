{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/chronic_preventive_services.schema.json",
  "title": "Preventive services lookup content (criteria, summaries, Massachusetts programs)",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "general_notes",
    "programs",
    "recommendations"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "chronic-preventive-services"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "age_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "sex": {
          "enum": [
            "any",
            "female",
            "male"
          ]
        },
        "pregnancy": {
          "enum": [
            "any",
            "pregnant",
            "pregnant_or_postpartum",
            "not_pregnant"
          ]
        },
        "all_of": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "offered_by",
        "summary",
        "eligibility",
        "contact",
        "sites",
        "url",
        "sources",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "offered_by": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "eligibility": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "place",
              "phone"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "place": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          }
        },
        "url": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "rec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "label",
        "criteria",
        "confirm",
        "client_summary",
        "programs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "cancer",
            "heart_metabolic",
            "infectious",
            "mental_health",
            "pregnancy",
            "children",
            "older_adults",
            "injury_violence",
            "tobacco"
          ]
        },
        "label": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criteria"
          }
        },
        "assumption": {
          "type": "string"
        },
        "confirm": {
          "type": "string"
        },
        "client_summary": {
          "type": "string"
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "general_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rec"
      }
    }
  }
}
