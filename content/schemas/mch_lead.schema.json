{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/mch_lead.schema.json",
  "title": "Massachusetts childhood lead screening and case management",
  "type": "object",
  "required": ["meta", "sources", "definitions", "screening_schedule", "high_risk_criteria", "high_risk_communities", "capillary_confirmation", "capillary_confirmation_source", "capillary_confirmation_section", "venous_actions", "venous_actions_source", "venous_actions_section", "specialty_clinics", "reporting", "lead_law", "teaching", "contacts"],
  "additionalProperties": false,
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "cited_text": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "age_band": {
      "type": "object",
      "required": ["age_months_from", "age_months_to", "label"],
      "additionalProperties": false,
      "properties": {
        "age_months_from": {"type": "number", "minimum": 0},
        "age_months_to": {"type": "number", "minimum": 0},
        "label": {"type": "string"}
      }
    },
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "mch-lead-screening"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "effective_date", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "effective_date": {"type": ["string", "null"]},
          "retrieved": {"type": "string"}
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "text", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "term": {"type": "string"},
          "text": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "screening_schedule": {
      "type": "object",
      "required": ["routine", "high_risk_community", "source", "section", "entry", "sample", "provider_duty"],
      "additionalProperties": false,
      "properties": {
        "routine": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/age_band"}},
        "high_risk_community": {"$ref": "#/$defs/age_band"},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "entry": {"$ref": "#/$defs/cited_text"},
        "sample": {"$ref": "#/$defs/cited_text"},
        "provider_duty": {"$ref": "#/$defs/cited_text"}
      }
    },
    "high_risk_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "schedule", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["household_poisoned", "renovation", "deteriorated_paint", "clinical_judgment"]},
          "text": {"type": "string"},
          "schedule": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "high_risk_communities": {
      "type": "object",
      "required": ["year", "period", "method", "source", "section", "towns", "note"],
      "additionalProperties": false,
      "properties": {
        "year": {"type": "integer"},
        "period": {"type": "string"},
        "method": {"type": "string"},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "towns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "capillary_confirmation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "timing"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "number"},
          "to": {"type": ["number", "null"]},
          "timing": {"type": "string"}
        }
      }
    },
    "capillary_confirmation_source": {"type": "string"},
    "capillary_confirmation_section": {"type": "string"},
    "venous_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "category", "provider", "environmental", "case_management", "retest"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "number"},
          "to": {"type": ["number", "null"]},
          "category": {"type": "string"},
          "provider": {"type": "string"},
          "environmental": {"type": "string"},
          "case_management": {"type": "string"},
          "retest": {"type": "string"}
        }
      }
    },
    "venous_actions_source": {"type": "string"},
    "venous_actions_section": {"type": "string"},
    "specialty_clinics": {"$ref": "#/$defs/cited_text"},
    "reporting": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
    "lead_law": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
    "teaching": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "text", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "topic": {"type": "string"},
          "text": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"},
          "confidence": {"$ref": "#/$defs/confidence"}
        }
      }
    },
    "contacts": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}}
  }
}
