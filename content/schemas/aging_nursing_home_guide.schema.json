{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/aging_nursing_home_guide.schema.json",
  "title": "Nursing home data guide",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "notes",
    "scope_severity",
    "infection_control_tags",
    "infection_control_tags_source",
    "contacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "aging-nursing-home-guide"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "scope_severity": {
      "type": "object",
      "required": [
        "confidence",
        "text",
        "harm_letters",
        "immediate_jeopardy_letters",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "text": {
          "type": "string"
        },
        "harm_letters": {
          "$ref": "#/$defs/strings"
        },
        "immediate_jeopardy_letters": {
          "$ref": "#/$defs/strings"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "infection_control_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^F\\d{4}$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "infection_control_tags_source": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    }
  }
}
