{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/data_sources.schema.json",
  "title": "Data source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "general_caveats",
    "sources"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "general_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "publisher",
          "kind",
          "status",
          "homepage",
          "probe_url",
          "used_by",
          "caveats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "content",
              "snapshot",
              "live",
              "local"
            ]
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "retired"
            ]
          },
          "planned_phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          },
          "content_id": {
            "type": "string"
          },
          "snapshot_id": {
            "type": "string"
          },
          "homepage": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "probe_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              }
            },
            "then": {
              "required": [
                "planned_phase"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "snapshot"
                },
                "status": {
                  "const": "active"
                }
              }
            },
            "then": {
              "required": [
                "snapshot_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "content"
                }
              }
            },
            "then": {
              "required": [
                "content_id"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_due": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string"
              }
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  }
}
