{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_housing_conditions.schema.json",
  "title": "Housing conditions and health (105 CMR 410.000)",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "conditions",
    "urgent_list",
    "inspection",
    "tenant_protections",
    "legal_notice",
    "teaching_sheets",
    "letters"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-housing-conditions"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "code_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "text"
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "keywords",
          "urgent",
          "urgent_note",
          "code",
          "owner",
          "occupant",
          "health_effects",
          "at_risk",
          "advice"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "urgent": {
            "type": "boolean"
          },
          "urgent_note": {
            "type": "string",
            "minLength": 20
          },
          "code": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/code_item"
            }
          },
          "owner": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "occupant": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "health_effects": {
            "$ref": "#/$defs/cited_list"
          },
          "at_risk": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "advice": {
            "$ref": "#/$defs/cited_list"
          }
        }
      }
    },
    "urgent_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "section",
        "items"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 17,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "during",
        "after",
        "hearings"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/cited_list"
        },
        "during": {
          "$ref": "#/$defs/cited_list"
        },
        "after": {
          "$ref": "#/$defs/cited_list"
        },
        "hearings": {
          "$ref": "#/$defs/cited_list"
        }
      }
    },
    "tenant_protections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "text",
          "source",
          "section",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "legal_notice": {
      "type": "string",
      "minLength": 20
    },
    "teaching_sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "condition",
          "sources",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string"
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "markdown": {
            "type": "string",
            "minLength": 100,
            "pattern": "^# "
          }
        }
      }
    },
    "letters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "inspection_request",
        "repair_request"
      ],
      "properties": {
        "placeholders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "inspection_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description",
            "markdown"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": {
              "type": "string"
            },
            "markdown": {
              "type": "string",
              "minLength": 50,
              "pattern": "^# "
            }
          }
        },
        "repair_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description",
            "markdown"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": {
              "type": "string"
            },
            "markdown": {
              "type": "string",
              "minLength": 50,
              "pattern": "^# "
            }
          }
        }
      }
    }
  }
}
