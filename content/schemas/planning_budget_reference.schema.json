{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/planning_budget_reference.schema.json",
  "title": "Federal budget object classes, MTDC, de minimis rate, cost sharing, and justification templates",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "rules",
    "object_classes",
    "funder_checks",
    "narrative"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "planning-budget-reference"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "de_minimis",
        "subaward_cap_in_mtdc",
        "equipment_threshold",
        "mtdc",
        "equipment",
        "participant_support",
        "subaward_vs_contract",
        "fringe",
        "cost_sharing"
      ],
      "additionalProperties": false,
      "properties": {
        "de_minimis": {
          "type": "object",
          "required": [
            "rate_percent",
            "base",
            "text",
            "source",
            "section",
            "confidence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "rate_percent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "base": {
              "const": "mtdc"
            },
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "subaward_cap_in_mtdc": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "equipment_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mtdc": {
          "$ref": "#/$defs/cited"
        },
        "equipment": {
          "$ref": "#/$defs/cited"
        },
        "participant_support": {
          "$ref": "#/$defs/cited"
        },
        "subaward_vs_contract": {
          "$ref": "#/$defs/cited"
        },
        "fringe": {
          "$ref": "#/$defs/cited"
        },
        "cost_sharing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cited"
          }
        }
      }
    },
    "object_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sf424a_line",
          "what",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sf424a_line": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "funder_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "title",
        "intro",
        "personnel_heading",
        "personnel_intro",
        "personnel_line",
        "fringe_heading",
        "fringe_text",
        "travel_heading",
        "travel_line",
        "equipment_heading",
        "equipment_line",
        "equipment_none",
        "supplies_heading",
        "supplies_line",
        "contractual_heading",
        "contract_line",
        "subaward_line",
        "other_heading",
        "other_line",
        "indirect_heading",
        "indirect_de_minimis",
        "indirect_negotiated",
        "indirect_none",
        "cost_share_heading",
        "cost_share_text",
        "cost_share_none",
        "summary_heading",
        "closing"
      ]
    }
  }
}
