{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/comms_safe_messaging.schema.json",
  "title": "Safe messaging about suicide",
  "type": "object",
  "required": ["meta", "sources", "rules", "required", "checklist"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "pattern": "^https://"}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "comms-safe-messaging"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "date"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": ["string", "null"], "pattern": "^https://"},
          "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "message", "fix", "patterns", "requires", "source", "section", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "severity": {"enum": ["must_fix", "should_fix"]},
          "message": {"type": "string"},
          "fix": {"type": "string"},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requires": {"type": "array", "items": {"type": "string"}},
          "except": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "section": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message", "fix", "patterns", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "message": {"type": "string"},
          "fix": {"type": "string"},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "checklist": {"type": "array", "items": {"type": "string"}}
  }
}
