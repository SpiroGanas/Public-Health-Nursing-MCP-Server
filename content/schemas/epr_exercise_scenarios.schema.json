{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_exercise_scenarios.schema.json",
  "title": "Exercise scenarios and seeds",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "scenarios",
    "seeds"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "text_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "cite_ref": {
      "type": "object",
      "required": [
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-exercise-scenarios"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "phep_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^phep-\\d{1,2}$"
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "hazard",
          "mission_areas",
          "summary",
          "phep",
          "functional_groups",
          "suggested_objectives",
          "facts",
          "related_tools",
          "modules"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hazard": {
            "type": "string",
            "minLength": 1
          },
          "mission_areas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "prevention",
                "protection",
                "mitigation",
                "response",
                "recovery"
              ]
            }
          },
          "summary": {
            "type": "string",
            "minLength": 40
          },
          "phep": {
            "$ref": "#/$defs/phep_ids"
          },
          "functional_groups": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "suggested_objectives": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "text",
                "phep"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 30
                },
                "phep": {
                  "$ref": "#/$defs/phep_ids"
                }
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fact"
            }
          },
          "related_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "modules": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "number",
                "title",
                "timeframe",
                "injects",
                "key_issues",
                "questions"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1
                },
                "injects": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "time",
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 20
                      }
                    }
                  }
                },
                "key_issues": {
                  "$ref": "#/$defs/text_list"
                },
                "questions": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "object",
                    "required": [
                      "group",
                      "text",
                      "phep"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "group": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 15
                      },
                      "phep": {
                        "$ref": "#/$defs/phep_ids"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "hazard",
          "summary",
          "phep",
          "related_tools"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "hazard": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 30
          },
          "phep": {
            "$ref": "#/$defs/phep_ids"
          },
          "fema": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "related_tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
