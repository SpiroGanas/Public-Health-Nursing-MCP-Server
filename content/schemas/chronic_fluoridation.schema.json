{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/chronic_fluoridation.schema.json",
  "title": "Community water fluoridation positions, evidence, law, and discussion points",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "standards",
    "status_definitions",
    "positions",
    "evidence",
    "divergences",
    "ma_law",
    "discussion_points",
    "not_included",
    "links"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "chronic-fluoridation"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "standards": {
      "$ref": "#/$defs/cited_list"
    },
    "status_definitions": {
      "$ref": "#/$defs/cited_list"
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body",
          "kind",
          "date",
          "position",
          "source",
          "section",
          "confidence"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review",
          "finding",
          "source",
          "section",
          "confidence"
        ],
        "properties": {
          "review": {
            "type": "string"
          },
          "finding": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "divergences": {
      "$ref": "#/$defs/cited_list"
    },
    "ma_law": {
      "$ref": "#/$defs/cited_list"
    },
    "discussion_points": {
      "$ref": "#/$defs/cited_list"
    },
    "not_included": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
