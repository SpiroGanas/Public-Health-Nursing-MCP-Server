{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/planning_behavior_theories.schema.json",
  "title": "Health behavior and behavior change theories (constructs, strategies, and measures)",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "how_to_choose",
    "theories"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "planning-behavior-theories"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "text",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "basis": {
          "enum": [
            "source",
            "authored"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "text",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "type": {
          "enum": [
            "knowledge",
            "belief",
            "behavior",
            "process",
            "environment"
          ]
        }
      }
    },
    "construct": {
      "type": "object",
      "required": [
        "id",
        "name",
        "definition",
        "confidence",
        "signals",
        "strategies",
        "measures"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string",
          "minLength": 10
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "signals": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "strategies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strategy"
          }
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "theory": {
      "type": "object",
      "required": [
        "id",
        "name",
        "abbreviation",
        "level",
        "kind",
        "summary",
        "best_for",
        "limits",
        "sources",
        "constructs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "explanatory theory",
            "change theory",
            "framework"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 30
        },
        "best_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "constructs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/construct"
          }
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "how_to_choose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "theories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theory"
      }
    }
  }
}
