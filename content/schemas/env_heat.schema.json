{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_heat.schema.json",
  "title": "Heat response planning",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "heatrisk_levels",
    "heatrisk_source",
    "heatrisk_section",
    "heat_sensitive_groups",
    "activation",
    "outreach_scripts",
    "schools_and_child_care",
    "outdoor_workers",
    "heat_illness",
    "heat_illness_source",
    "heat_illness_section",
    "medications_and_power",
    "cooling_center_columns",
    "links"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-heat-health"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "heatrisk_levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "level",
          "name",
          "color",
          "meaning",
          "who_at_risk",
          "actions"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "meaning": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "who_at_risk": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "heatrisk_source": {
      "type": "string"
    },
    "heatrisk_section": {
      "type": "string"
    },
    "heat_sensitive_groups": {
      "$ref": "#/$defs/cited_list"
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "actions"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "actions": {
            "$ref": "#/$defs/cited_list"
          }
        }
      }
    },
    "outreach_scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lines",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "schools_and_child_care": {
      "$ref": "#/$defs/cited_list"
    },
    "outdoor_workers": {
      "$ref": "#/$defs/cited_list"
    },
    "heat_illness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "signs",
          "response"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "signs": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      }
    },
    "heat_illness_source": {
      "type": "string"
    },
    "heat_illness_section": {
      "type": "string"
    },
    "medications_and_power": {
      "$ref": "#/$defs/cited_list"
    },
    "cooling_center_columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "aliases"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
