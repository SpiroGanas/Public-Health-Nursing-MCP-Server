{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_environmental_justice.schema.json",
  "title": "Massachusetts environmental justice populations",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "criteria",
    "criteria_source",
    "criteria_section",
    "neighborhood_definition",
    "secretary_designation",
    "layer_facts",
    "state_block_groups",
    "what_designation_means",
    "language_access",
    "dph_vulnerable_health",
    "how_to_use",
    "ejscreen",
    "eji"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-environmental-justice"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "statute",
          "data",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "M",
              "I",
              "E"
            ]
          },
          "label": {
            "type": "string"
          },
          "statute": {
            "type": "string",
            "minLength": 20
          },
          "data": {
            "type": "string",
            "minLength": 20
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "criteria_source": {
      "type": "string"
    },
    "criteria_section": {
      "type": "string"
    },
    "neighborhood_definition": {
      "$ref": "#/$defs/cited"
    },
    "secretary_designation": {
      "$ref": "#/$defs/cited"
    },
    "layer_facts": {
      "$ref": "#/$defs/cited_list"
    },
    "what_designation_means": {
      "$ref": "#/$defs/cited_list"
    },
    "language_access": {
      "$ref": "#/$defs/cited_list"
    },
    "dph_vulnerable_health": {
      "type": "object",
      "required": [
        "intro",
        "criteria",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 20
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "criterion"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "criterion": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "how_to_use": {
      "$ref": "#/$defs/cited_list"
    },
    "ejscreen": {
      "type": "object",
      "required": [
        "status",
        "status_confidence",
        "where_to_get",
        "id_column",
        "population_column",
        "indicators",
        "indicators_source",
        "filter",
        "percentile_note"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 20
        },
        "status_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "where_to_get": {
          "type": "string",
          "minLength": 20
        },
        "id_column": {
          "type": "string"
        },
        "population_column": {
          "type": "string"
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "column",
              "label",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string",
                "pattern": "^P_[A-Z0-9_]+$"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "environmental",
                  "ej_index",
                  "demographic"
                ]
              }
            }
          }
        },
        "indicators_source": {
          "type": "string"
        },
        "filter": {
          "$ref": "#/$defs/cited"
        },
        "percentile_note": {
          "$ref": "#/$defs/cited"
        }
      }
    },
    "eji": {
      "$ref": "#/$defs/cited"
    },
    "state_block_groups": {
      "type": "object",
      "required": [
        "count",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    }
  }
}
