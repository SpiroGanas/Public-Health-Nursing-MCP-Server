{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/aging_advance_care_planning.schema.json",
  "title": "Advance care planning",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "proxy_rules",
    "proxy_template",
    "after_signing",
    "molst",
    "conversation_project",
    "facilitator_script",
    "handout_points"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "aging-advance-care-planning"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "proxy_rules": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "proxy_template": {
      "type": "object",
      "required": [
        "title",
        "confidence",
        "sections",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "fields",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "fields": {
                "$ref": "#/$defs/strings"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "after_signing": {
      "$ref": "#/$defs/strings"
    },
    "molst": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "text",
        "warning"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "not_verified"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "text": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        }
      }
    },
    "conversation_project": {
      "type": "object",
      "required": [
        "url",
        "text",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "facilitator_script": {
      "type": "object",
      "required": [
        "confidence",
        "note",
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "note": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "minutes",
              "script"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "minutes": {
                "type": "integer",
                "minimum": 1
              },
              "script": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "handout_points": {
      "$ref": "#/$defs/strings"
    }
  }
}
