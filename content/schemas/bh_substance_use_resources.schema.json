{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/bh_substance_use_resources.schema.json",
  "title": "Naloxone, harm reduction, and substance use treatment resources",
  "type": "object",
  "required": ["meta", "sources", "contacts", "standing_order", "access", "pharmacy_rules", "legal", "syringe_services", "fentanyl_test_strips", "risk_factors", "teaching_script"],
  "additionalProperties": true,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "pattern": "^https://"}
      }
    },
    "cited": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "bh-substance-use-resources"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "date"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": ["string", "null"], "pattern": "^https://"},
          "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "detail", "source"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "detail": {"type": "string"}, "source": {"type": "string"}}
      }
    },
    "standing_order": {
      "type": "object",
      "required": ["signed", "authority", "formulations", "why_preferred"],
      "additionalProperties": false,
      "properties": {
        "signed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "authority": {"type": "string"},
        "why_preferred": {"type": "string"},
        "formulations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "dispense", "directions"],
            "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "dispense": {"type": "string"}, "directions": {"type": "string"}}
          }
        }
      }
    },
    "access": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
    "pharmacy_rules": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
    "legal": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
    "syringe_services": {
      "type": "object",
      "required": ["statute", "statute_source", "list_source", "list_note", "approved_towns"],
      "additionalProperties": false,
      "properties": {
        "statute": {"type": "string"},
        "statute_source": {"type": "string"},
        "list_source": {"type": "string"},
        "list_note": {"type": "string"},
        "approved_towns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "fentanyl_test_strips": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
    "risk_factors": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
    "teaching_script": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["step", "text", "sources"],
        "additionalProperties": false,
        "properties": {
          "step": {"type": "string"},
          "text": {"type": "string"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
