{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/comms_readability.schema.json",
  "title": "Readability, plain language, and the CDC Clear Communication Index",
  "type": "object",
  "required": ["meta", "sources", "formulas", "flesch_bands", "smog_table", "thresholds", "guidance", "cci", "extra_terms", "jargon"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "pattern": "^https://"}
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "term": {
      "type": "object",
      "required": ["term", "match", "plain", "note", "check_context", "source"],
      "additionalProperties": false,
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "match": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9 '-]*$"}},
        "plain": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]},
        "example_before": {"type": "string"},
        "example_after": {"type": "string"},
        "check_context": {"type": "boolean"},
        "source": {"type": "string"}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "comms-readability"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "date"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": ["string", "null"], "pattern": "^https://"},
          "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "formulas": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "formula", "scale", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["flesch_reading_ease", "flesch_kincaid_grade", "smog", "gunning_fog"]},
          "name": {"type": "string"},
          "formula": {"type": "string"},
          "scale": {"type": "string"},
          "source": {"type": "string"},
          "confidence": {"$ref": "#/$defs/confidence"}
        }
      }
    },
    "flesch_bands": {
      "type": "object",
      "required": ["confidence", "source", "bands"],
      "additionalProperties": false,
      "properties": {
        "confidence": {"$ref": "#/$defs/confidence"},
        "source": {"type": "string"},
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["min", "label"],
            "additionalProperties": false,
            "properties": {"min": {"type": "number"}, "label": {"type": "string"}}
          }
        }
      }
    },
    "smog_table": {
      "type": "object",
      "required": ["source", "section", "note", "accuracy", "rows"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "section": {"type": "string"},
        "note": {"type": "string"},
        "accuracy": {"type": "string"},
        "rows": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["min", "max", "grade"],
            "additionalProperties": false,
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 0},
              "grade": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["default_target_grade", "default_target_grade_note", "long_sentence_words", "long_sentence_source", "typical_sentence_words", "typical_sentence_source", "paragraph_max_sentences", "paragraph_source", "list_max_items", "list_source", "main_ideas_max", "main_ideas_source"],
      "additionalProperties": false,
      "properties": {
        "default_target_grade": {"type": "number", "minimum": 1, "maximum": 16},
        "default_target_grade_note": {"type": "string"},
        "long_sentence_words": {"type": "integer", "minimum": 5},
        "long_sentence_source": {"type": "string"},
        "typical_sentence_words": {"type": "string"},
        "typical_sentence_source": {"type": "string"},
        "paragraph_max_sentences": {"type": "integer", "minimum": 1},
        "paragraph_source": {"type": "string"},
        "list_max_items": {"type": "integer", "minimum": 1},
        "list_source": {"type": "string"},
        "main_ideas_max": {"type": "integer", "minimum": 1},
        "main_ideas_source": {"type": "string"}
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source", "section"],
        "additionalProperties": false,
        "properties": {"text": {"type": "string"}, "source": {"type": "string"}, "section": {"type": "string"}}
      }
    },
    "cci": {
      "type": "object",
      "required": ["passing_score", "passing_source", "rules", "intro_questions", "parts", "items"],
      "additionalProperties": false,
      "properties": {
        "passing_score": {"type": "number"},
        "passing_source": {"type": "string"},
        "rules": {"type": "array", "items": {"type": "string"}},
        "intro_questions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
        "parts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "name", "applies_question"],
            "additionalProperties": false,
            "properties": {
              "id": {"enum": ["A", "B", "C", "D"]},
              "name": {"type": "string"},
              "applies_question": {"type": ["string", "null"]}
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["number", "part", "area", "guide_page", "na_allowed", "yes_scores", "question", "guidance"],
            "additionalProperties": false,
            "properties": {
              "number": {"type": "integer", "minimum": 1, "maximum": 20},
              "part": {"enum": ["A", "B", "C", "D"]},
              "area": {"type": "string"},
              "guide_page": {"type": "integer"},
              "na_allowed": {"type": "boolean"},
              "yes_scores": {"enum": [0, 1]},
              "question": {"type": "string"},
              "guidance": {"type": "string"}
            }
          }
        }
      }
    },
    "extra_terms": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "jargon": {"type": "array", "minItems": 50, "items": {"$ref": "#/$defs/term"}}
  }
}
