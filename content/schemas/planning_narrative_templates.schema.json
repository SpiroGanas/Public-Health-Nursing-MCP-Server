{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/planning_narrative_templates.schema.json",
  "title": "Grant narrative section skeletons and reviewer prompts",
  "type": "object",
  "required": [
    "meta",
    "sections",
    "criterion_prompts"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "planning-narrative-templates"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "purpose",
          "slots"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "needs_statement",
              "project_narrative",
              "sustainability"
            ]
          },
          "heading": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "heading",
                "fact",
                "kind",
                "placeholder"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "fact": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "text",
                    "list",
                    "data"
                  ]
                },
                "placeholder": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "criterion_prompts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
