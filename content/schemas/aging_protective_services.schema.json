{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/aging_protective_services.schema.json",
  "title": "Protective services reporting",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "pathways",
    "definitions",
    "mandated_reporters",
    "duties",
    "report_contents",
    "timelines",
    "protections",
    "penalties",
    "after_report",
    "self_neglect",
    "signs",
    "narrative_template",
    "emergency"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reporters": {
      "type": "object",
      "required": [
        "list",
        "trigger",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "aging-protective-services"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "pathways": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "who",
          "age_min",
          "age_max",
          "setting",
          "hotline",
          "hours",
          "how",
          "online",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "elder_aps",
              "dppc",
              "dph_facility"
            ]
          },
          "name": {
            "type": "string"
          },
          "who": {
            "type": "string"
          },
          "age_min": {
            "type": [
              "integer",
              "null"
            ]
          },
          "age_max": {
            "type": [
              "integer",
              "null"
            ]
          },
          "setting": {
            "enum": [
              "community",
              "facility",
              "any"
            ]
          },
          "hotline": {
            "type": "string",
            "pattern": "^\\(\\d{3}\\) \\d{3}-\\d{4}$"
          },
          "hours": {
            "type": "string"
          },
          "how": {
            "type": "string"
          },
          "online": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "text",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "mandated_reporters": {
      "type": "object",
      "required": [
        "elder",
        "disabled"
      ],
      "additionalProperties": false,
      "properties": {
        "elder": {
          "$ref": "#/$defs/reporters"
        },
        "disabled": {
          "$ref": "#/$defs/reporters"
        }
      }
    },
    "duties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "report_contents": {
      "$ref": "#/$defs/cited_text"
    },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "when",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "protections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "penalties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "after_report": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "self_neglect": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "signs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "signs",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "signs": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "narrative_template": {
      "type": "object",
      "required": [
        "title",
        "sections",
        "confidence",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "fields",
              "guidance"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "fields": {
                "$ref": "#/$defs/strings"
              },
              "guidance": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "emergency": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    }
  }
}
