{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/ebp_qi_research_determination.schema.json",
  "title": "QI versus research determination",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "definitions",
    "categories",
    "questions",
    "what_irb_decides",
    "next_steps",
    "document",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "ebp-qi-research-determination"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "term",
          "quote",
          "paraphrase",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "paraphrase": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "summary",
          "typical_features",
          "irb_note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "typical_features": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cited"
            }
          },
          "irb_note": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "prompt",
          "help",
          "yes_means",
          "no_means",
          "needed",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "purpose",
              "burden",
              "authority",
              "human_subjects",
              "context"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "yes_means": {
            "enum": [
              "research",
              "non_research",
              "human_subject",
              "info",
              "none"
            ]
          },
          "no_means": {
            "enum": [
              "research",
              "non_research",
              "human_subject",
              "info",
              "none"
            ]
          },
          "needed": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "basis": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cited"
            }
          }
        }
      }
    },
    "what_irb_decides": {
      "type": "string"
    },
    "next_steps": {
      "type": "object",
      "required": [
        "possible_research",
        "qi",
        "program_evaluation",
        "public_health_practice",
        "undetermined"
      ],
      "additionalProperties": false,
      "properties": {
        "possible_research": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qi": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "program_evaluation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_health_practice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "undetermined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "filename",
        "intro",
        "placeholders",
        "sections",
        "answers_heading",
        "answers_note"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "prompts"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "answers_heading": {
          "type": "string"
        },
        "answers_note": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
