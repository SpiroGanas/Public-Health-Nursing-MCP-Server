{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_hazard_health_actions.schema.json",
  "title": "Hazard alerts, health effects, and public health actions",
  "type": "object",
  "required": ["meta", "sources", "general_actions", "hazards", "secondary_hazards", "fema_incident_labels"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    },
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "epr-hazard-health-actions"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "publisher", "url", "effective_date", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "effective_date": {"type": ["string", "null"]},
        "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "cited": {
      "type": "object",
      "required": ["text", "source", "section", "confidence"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "cited_list": {"type": "array", "items": {"$ref": "#/$defs/cited"}}
  },
  "properties": {
    "meta": {"$ref": "#/$defs/meta"},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source"}},
    "general_actions": {"$ref": "#/$defs/cited_list"},
    "hazards": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "label", "nws_events", "fema_incident_types", "health_effects", "at_risk", "public_health_actions", "public_messages", "message_sources", "related_tools"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "label": {"type": "string"},
          "nws_events": {"type": "array", "items": {"type": "string"}},
          "fema_incident_types": {"type": "array", "items": {"type": "string"}},
          "health_effects": {"$ref": "#/$defs/cited_list"},
          "at_risk": {"$ref": "#/$defs/cited_list"},
          "public_health_actions": {"$ref": "#/$defs/cited_list"},
          "public_messages": {"type": "array", "items": {"type": "string"}},
          "message_sources": {"type": "array", "items": {"type": "string"}},
          "related_tools": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}},
          "secondary": {"type": "array", "items": {"enum": ["power_outage", "carbon_monoxide"]}}
        }
      }
    },
    "secondary_hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "health_effects", "public_health_actions", "public_messages", "message_sources"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["power_outage", "carbon_monoxide"]},
          "label": {"type": "string"},
          "health_effects": {"$ref": "#/$defs/cited_list"},
          "public_health_actions": {"$ref": "#/$defs/cited_list"},
          "public_messages": {"type": "array", "items": {"type": "string"}},
          "message_sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "fema_incident_labels": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
