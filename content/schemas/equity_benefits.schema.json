{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/equity_benefits.schema.json",
  "title": "Benefit eligibility income limits",
  "type": "object",
  "required": [
    "meta",
    "refresh_schedule",
    "sources",
    "fpl",
    "programs",
    "general_caveats"
  ],
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "equity-benefit-eligibility"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "refresh_schedule": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string"
          }
        }
      }
    },
    "fpl": {
      "type": "object",
      "required": [
        "year",
        "area",
        "base",
        "each_additional",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer"
        },
        "area": {
          "type": "string"
        },
        "base": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number"
          }
        },
        "each_additional": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "who",
          "income_basis",
          "limit_type",
          "percent_fpl",
          "effective",
          "automatic",
          "apply",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "name": {
            "type": "string"
          },
          "who": {
            "type": "string"
          },
          "income_basis": {
            "enum": [
              "gross",
              "magi"
            ]
          },
          "limit_type": {
            "enum": [
              "table_annual",
              "table_monthly",
              "percent_fpl"
            ]
          },
          "annual": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "monthly": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "each_additional": {
            "type": [
              "number",
              "null"
            ]
          },
          "percent_fpl": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_benefit_monthly": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "max_benefit_each_additional": {
            "type": "number"
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "percent_fpl",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "percent_fpl": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "effective": {
            "type": "string"
          },
          "automatic": {
            "type": "string"
          },
          "apply": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "general_caveats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    }
  }
}
