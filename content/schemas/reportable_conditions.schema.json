{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/reportable_conditions.schema.json",
  "title": "Massachusetts reportable conditions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "contacts",
    "timeframes",
    "reporters",
    "conditions"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "contacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\d{3}-\\d{3}-\\d{4}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "timeframes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediate",
        "within_24_hours",
        "other"
      ],
      "properties": {
        "immediate": {
          "type": "string"
        },
        "within_24_hours": {
          "type": "string"
        },
        "other": {
          "type": "string"
        }
      }
    },
    "reporters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_care_provider",
        "laboratory",
        "local_board_of_health"
      ],
      "properties": {
        "health_care_provider": {
          "type": "string"
        },
        "laboratory": {
          "type": "string"
        },
        "local_board_of_health": {
          "type": "string"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "aliases",
          "category",
          "timeframe",
          "reporters",
          "report_to",
          "guide_chapter",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lab_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "enum": [
              "select_agent",
              "vaccine_preventable",
              "invasive_bacterial",
              "enteric",
              "vectorborne",
              "zoonotic",
              "respiratory",
              "bloodborne",
              "sexually_transmitted",
              "mycobacterial",
              "healthcare_associated",
              "environmental",
              "other"
            ]
          },
          "timeframe": {
            "enum": [
              "immediate",
              "within_24_hours",
              "other"
            ]
          },
          "reporters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "health_care_provider",
                "laboratory",
                "local_board_of_health"
              ]
            }
          },
          "report_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "local_board_of_health",
                "dph"
              ]
            }
          },
          "guide_chapter": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_due": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string"
              }
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  }
}
