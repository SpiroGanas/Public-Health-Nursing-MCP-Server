{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/infection_control.schema.json",
  "title": "Infection control for congregate settings",
  "type": "object",
  "required": ["meta", "sources", "precaution_types", "epa_lists", "disinfectant_basics", "settings", "pathogens"],
  "additionalProperties": false,
  "$defs": {
    "cited_text": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    },
    "setting_id": {"enum": ["long_term_care", "school", "child_care", "shelter", "day_program"]}
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "ma-infection-control"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "effective_date", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "effective_date": {"type": ["string", "null"]},
          "retrieved": {"type": "string"}
        }
      }
    },
    "precaution_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "definition", "ppe", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["standard", "contact", "droplet", "airborne", "enteric"]},
          "label": {"type": "string"},
          "definition": {"type": "string"},
          "ppe": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "epa_lists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]$"},
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://www\\.epa\\.gov/"}
        }
      }
    },
    "disinfectant_basics": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "health_care_setting", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/setting_id"},
          "label": {"type": "string"},
          "health_care_setting": {"type": "boolean"},
          "notes": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}}
        }
      }
    },
    "pathogens": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "precautions", "duration", "appendix_a_comment", "epa_lists", "hand_hygiene", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "precautions": {"type": "string"},
          "duration": {"type": "string"},
          "appendix_a_comment": {"type": "string"},
          "epa_lists": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]$"}},
          "hand_hygiene": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "setting_notes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "all": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
              "long_term_care": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
              "school": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
              "child_care": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
              "shelter": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}},
              "day_program": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}}
            }
          }
        }
      }
    }
  }
}
