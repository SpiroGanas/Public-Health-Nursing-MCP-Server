{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/leadership_phab_standards.schema.json",
  "title": "PHAB Standards & Measures Version 2022: structure and keyword cues",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "phab",
    "domains",
    "not_verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "leadership-phab-standards"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "phab": {
      "type": "object",
      "required": [
        "version_label",
        "version_check",
        "version_check_confidence",
        "license_note",
        "link",
        "link_note",
        "measures_note",
        "measure_columns",
        "document_types_note",
        "document_types",
        "match_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "version_label": {
          "type": "string"
        },
        "version_check": {
          "type": "string"
        },
        "version_check_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "license_note": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "pattern": "^https://"
        },
        "link_note": {
          "type": "string"
        },
        "measures_note": {
          "type": "string"
        },
        "measure_columns": {
          "type": "object",
          "required": [
            "id",
            "title",
            "keywords"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "keywords": {
              "type": "string"
            }
          }
        },
        "document_types_note": {
          "type": "string"
        },
        "document_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "cues",
              "standards",
              "source",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "standards": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "match_rules": {
          "type": "object",
          "required": [
            "strong",
            "some",
            "none",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "strong": {
              "type": "string"
            },
            "some": {
              "type": "string"
            },
            "none": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "standards"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "name": {
            "type": "string"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "cues",
                "document_types",
                "source",
                "confidence"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+$"
                },
                "title": {
                  "type": "string"
                },
                "cues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 3
                },
                "document_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source": {
                  "type": "string"
                },
                "confidence": {
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
