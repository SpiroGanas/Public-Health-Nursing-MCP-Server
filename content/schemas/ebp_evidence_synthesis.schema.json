{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/ebp_evidence_synthesis.schema.json",
  "title": "Evidence synthesis table and PRISMA 2020 flow",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "definitions",
    "flow",
    "table"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "ebp-evidence-synthesis"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "licence",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "minProperties": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "text",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "minItems": 3
    },
    "flow": {
      "type": "object",
      "required": [
        "statement",
        "source",
        "section",
        "steps",
        "arithmetic",
        "not_drawn"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "stage",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "stage": {
                "enum": [
                  "Identification",
                  "Screening",
                  "Included"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          },
          "minItems": 8
        },
        "arithmetic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_drawn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "summary_rows",
        "quality_scales_note"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "header"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "minItems": 5
        },
        "summary_rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_scales_note": {
          "type": "string"
        }
      }
    }
  }
}
