{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/mch_mandated_reporting.schema.json",
  "title": "Massachusetts mandated reporting of child abuse and neglect",
  "type": "object",
  "required": ["meta", "sources", "who_must_report", "when_to_report", "how_to_report", "report_contents", "penalties_and_protections", "definitions", "domestic_violence", "dcf_process", "warning_signs", "documentation_tips", "hotline", "template"],
  "additionalProperties": false,
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "cited_text": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "cited_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cited_text"}},
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "mch-mandated-reporting"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "effective_date", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "effective_date": {"type": ["string", "null"]},
          "retrieved": {"type": "string"}
        }
      }
    },
    "who_must_report": {"$ref": "#/$defs/cited_list"},
    "when_to_report": {"$ref": "#/$defs/cited_list"},
    "how_to_report": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "text", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "report_contents": {"$ref": "#/$defs/cited_list"},
    "penalties_and_protections": {"$ref": "#/$defs/cited_list"},
    "definitions": {"$ref": "#/$defs/cited_list"},
    "domestic_violence": {"$ref": "#/$defs/cited_list"},
    "dcf_process": {"$ref": "#/$defs/cited_list"},
    "warning_signs": {"$ref": "#/$defs/cited_list"},
    "documentation_tips": {"$ref": "#/$defs/cited_list"},
    "hotline": {"type": "string"},
    "template": {
      "type": "object",
      "required": ["title", "sections", "related_concerns", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["heading", "fields"],
            "additionalProperties": false,
            "properties": {
              "heading": {"type": "string"},
              "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "related_concerns": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"},
        "section": {"type": "string"}
      }
    }
  }
}
