{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_hva.schema.json",
  "title": "Hazard vulnerability assessment",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "method",
    "scales",
    "hazards",
    "hazard_source",
    "hazard_section",
    "nri"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-hazard-vulnerability"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "method": {
      "type": "object",
      "required": [
        "summary",
        "formula",
        "basis",
        "note",
        "phep_link"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "phep_link": {
          "$ref": "#/$defs/cited"
        }
      }
    },
    "scales": {
      "type": "object",
      "required": [
        "probability",
        "impact",
        "preparedness_gap",
        "seed_mapping"
      ],
      "additionalProperties": false,
      "properties": {
        "probability": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "score",
              "label",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "impact": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "score",
              "label",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "preparedness_gap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "score",
              "label",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "seed_mapping": {
          "type": "object",
          "required": [
            "likelihood",
            "human_consequence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "likelihood": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "human_consequence": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "category",
          "fema_incident_types",
          "nws_hazards",
          "nri_prefixes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "enum": [
              "natural",
              "technological",
              "public_health",
              "human_caused"
            ]
          },
          "resilientmass": {
            "type": "object",
            "required": [
              "likelihood",
              "human",
              "economic",
              "environment",
              "warning",
              "impact_scale"
            ],
            "additionalProperties": false,
            "properties": {
              "likelihood": {
                "enum": [
                  "Very high",
                  "High",
                  "Medium",
                  "Low",
                  "Very low"
                ]
              },
              "human": {
                "enum": [
                  "Very high",
                  "High",
                  "Medium",
                  "Low",
                  "Very low"
                ]
              },
              "economic": {
                "enum": [
                  "Very high",
                  "High",
                  "Medium",
                  "Low",
                  "Very low"
                ]
              },
              "environment": {
                "enum": [
                  "Very high",
                  "High",
                  "Medium",
                  "Low",
                  "Very low"
                ]
              },
              "warning": {
                "type": "string"
              },
              "impact_scale": {
                "type": "string"
              }
            }
          },
          "fema_incident_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nws_hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nri_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hazard_source": {
      "type": "string"
    },
    "hazard_section": {
      "type": "string"
    },
    "nri": {
      "type": "object",
      "required": [
        "county_id_columns",
        "tract_id_columns",
        "overall_score",
        "overall_rating",
        "hazard_score_suffix",
        "hazard_rating_suffix",
        "hazard_frequency_suffix",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "county_id_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tract_id_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall_score": {
          "type": "string"
        },
        "overall_rating": {
          "type": "string"
        },
        "hazard_score_suffix": {
          "type": "string"
        },
        "hazard_rating_suffix": {
          "type": "string"
        },
        "hazard_frequency_suffix": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
