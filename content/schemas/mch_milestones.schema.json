{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/mch_milestones.schema.json",
  "title": "CDC developmental milestones and Massachusetts Early Intervention referral",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "definition",
    "share_with_doctor",
    "act_early",
    "screening",
    "early_intervention",
    "ei_town_aliases",
    "ages"
  ],
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "mch-developmental-milestones"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string"
          }
        }
      }
    },
    "definition": {
      "$ref": "#/$defs/cited_text"
    },
    "share_with_doctor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "act_early": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "screening": {
      "type": "object",
      "required": [
        "general_months",
        "autism_months",
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "general_months": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "autism_months": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "early_intervention": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "ei_town_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "age_months",
          "label",
          "url",
          "updated",
          "domains"
        ],
        "additionalProperties": false,
        "properties": {
          "age_months": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.cdc\\.gov/"
          },
          "updated": {
            "type": "string"
          },
          "domains": {
            "type": "object",
            "required": [
              "social_emotional",
              "language_communication",
              "cognitive",
              "movement_physical"
            ],
            "additionalProperties": false,
            "properties": {
              "social_emotional": {
                "$ref": "#/$defs/items"
              },
              "language_communication": {
                "$ref": "#/$defs/items"
              },
              "cognitive": {
                "$ref": "#/$defs/items"
              },
              "movement_physical": {
                "$ref": "#/$defs/items"
              }
            }
          }
        }
      }
    }
  }
}
