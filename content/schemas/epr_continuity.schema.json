{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_continuity.schema.json",
  "title": "Continuity of operations planning for local boards of health",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-continuity"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "elements": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "checklist",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "timing",
          "actions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "label",
          "rto",
          "rto_hours",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "label": {
            "type": "string"
          },
          "rto": {
            "type": "string"
          },
          "rto_hours": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "tiers_note": {
      "type": "string"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "authority",
          "source",
          "tier",
          "minimum_staff",
          "dependencies",
          "incident_dependent",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "minimum_staff": {
            "type": "integer",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "incident_dependent": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "succession_defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "successors",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "string"
          },
          "successors": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "succession_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "authority",
          "delegated_to",
          "trigger",
          "limits",
          "legal_basis",
          "source",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "delegated_to": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          },
          "legal_basis": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "delegation_note": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "protection"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "protection": {
            "type": "string"
          }
        }
      }
    },
    "communications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "use",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "tte": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "activity",
          "kind",
          "frequency",
          "months",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "activity": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "test",
              "training",
              "exercise",
              "review"
            ]
          },
          "frequency": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            }
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "tte_note": {
      "type": "string"
    },
    "devolution": {
      "type": "object",
      "required": [
        "triggers",
        "partners",
        "agreement",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "partners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agreement": {
          "$ref": "#/$defs/cited"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reconstitution": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_capital": {
      "type": "object",
      "required": [
        "absenteeism",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "absenteeism": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "text",
            "source",
            "section",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "unit": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          }
        }
      }
    },
    "phep_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "pandemic_annex": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "required": [
    "meta",
    "sources",
    "elements",
    "phases",
    "tiers",
    "tiers_note",
    "functions",
    "succession_defaults",
    "succession_rules",
    "delegations",
    "delegation_note",
    "records",
    "communications",
    "tte",
    "tte_note",
    "devolution",
    "reconstitution",
    "human_capital",
    "phep_links",
    "pandemic_annex"
  ]
}
