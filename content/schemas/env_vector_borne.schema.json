{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_vector_borne.schema.json",
  "title": "Mosquito- and tick-borne disease risk levels, actions, and prevention",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "season",
    "eee_levels",
    "eee_source",
    "eee_section",
    "eee_response_source",
    "eee_response_section",
    "wnv_levels",
    "wnv_source",
    "wnv_section",
    "wnv_response_source",
    "wnv_response_section",
    "cancellation_times",
    "prevention",
    "disease_notes",
    "data_notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-vector-borne"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_month",
        "last_month",
        "description",
        "hard_frost",
        "peak",
        "focal_areas"
      ],
      "properties": {
        "first_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "last_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "description": {
          "$ref": "#/$defs/cited"
        },
        "hard_frost": {
          "$ref": "#/$defs/cited"
        },
        "peak": {
          "$ref": "#/$defs/cited"
        },
        "focal_areas": {
          "$ref": "#/$defs/cited"
        }
      }
    },
    "eee_levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "rank",
          "color",
          "meaning",
          "definition",
          "public_actions",
          "dph_response"
        ],
        "properties": {
          "level": {
            "enum": [
              "Remote",
              "Low",
              "Moderate",
              "High",
              "Critical"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "color": {
            "type": "string"
          },
          "meaning": {
            "type": "string",
            "minLength": 10
          },
          "definition": {
            "type": "string",
            "minLength": 10
          },
          "public_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1
          },
          "dph_response": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1
          }
        }
      }
    },
    "eee_source": {
      "type": "string"
    },
    "eee_section": {
      "type": "string"
    },
    "eee_response_source": {
      "type": "string"
    },
    "eee_response_section": {
      "type": "string"
    },
    "wnv_levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "rank",
          "color",
          "meaning",
          "definition",
          "public_actions",
          "dph_response"
        ],
        "properties": {
          "level": {
            "enum": [
              "Low",
              "Moderate",
              "High",
              "Critical"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "color": {
            "type": "string"
          },
          "meaning": {
            "type": "string",
            "minLength": 10
          },
          "definition": {
            "type": "string",
            "minLength": 10
          },
          "public_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1
          },
          "dph_response": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1
          }
        }
      }
    },
    "wnv_source": {
      "type": "string"
    },
    "wnv_section": {
      "type": "string"
    },
    "wnv_response_source": {
      "type": "string"
    },
    "wnv_response_section": {
      "type": "string"
    },
    "cancellation_times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "source",
        "section",
        "confidence",
        "note",
        "weeks"
      ],
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": "string"
        },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "start",
              "end"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "to": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{1,2}:\\d{2} (AM|PM)$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{1,2}:\\d{2} (AM|PM)$"
              }
            }
          }
        }
      }
    },
    "prevention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public",
        "schools",
        "camps",
        "outdoor_workers"
      ],
      "properties": {
        "public": {
          "$ref": "#/$defs/cited_list"
        },
        "schools": {
          "$ref": "#/$defs/cited_list"
        },
        "camps": {
          "$ref": "#/$defs/cited_list"
        },
        "outdoor_workers": {
          "$ref": "#/$defs/cited_list"
        }
      }
    },
    "disease_notes": {
      "$ref": "#/$defs/cited_list"
    },
    "data_notes": {
      "$ref": "#/$defs/cited_list"
    }
  }
}
