{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/vax_coverage_thresholds.schema.json",
  "title": "Herd immunity thresholds and coverage targets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "thresholds",
    "measure_map",
    "dph_small_school_rule"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disease",
          "vaccines",
          "r0",
          "threshold_pct_low",
          "threshold_pct_high",
          "flag_default_pct",
          "flag_basis",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "disease": {
            "type": "string"
          },
          "vaccines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "r0": {
            "type": [
              "string",
              "null"
            ]
          },
          "threshold_pct_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold_pct_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "flag_default_pct": {
            "type": "number"
          },
          "flag_basis": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "measure_map": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "dph_small_school_rule": {
      "type": "string"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_due": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string"
              }
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  }
}
