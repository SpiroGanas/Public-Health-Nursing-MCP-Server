{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/policy_nursing_scope_of_practice.schema.json",
  "title": "Massachusetts nursing scope of practice (partial snapshot)",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "read_scope",
    "decision_guidelines",
    "referral",
    "topics",
    "entries",
    "advisory_rulings",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "policy-nursing-scope-of-practice"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "read_scope": {
      "type": "object",
      "required": [
        "read_in_full",
        "read_in_part",
        "not_read"
      ],
      "additionalProperties": false,
      "properties": {
        "read_in_full": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_in_part": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision_guidelines": {
      "type": "object",
      "required": [
        "intro",
        "questions",
        "framework_steps",
        "framework_source",
        "framework_note"
      ],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "$ref": "#/$defs/cited"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "question",
              "if_yes",
              "if_no",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "question": {
                "type": "string"
              },
              "if_yes": {
                "type": "string"
              },
              "if_no": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "framework_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework_source": {
          "type": "string"
        },
        "framework_note": {
          "type": "string"
        }
      }
    },
    "referral": {
      "type": "object",
      "required": [
        "text",
        "contacts",
        "source",
        "contact_source",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "contact_source": {
          "type": "string"
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "keywords"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "required": [],
      "additionalProperties": true,
      "properties": {},
      "items": {
        "type": "object",
        "required": [
          "id",
          "topics",
          "citation",
          "source",
          "section",
          "applies_to",
          "quote",
          "paraphrase",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "enum": [
                "rn",
                "lpn",
                "aprn"
              ]
            }
          },
          "quote": {
            "type": "string"
          },
          "paraphrase": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "advisory_rulings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "title",
          "area",
          "issued",
          "last_revised",
          "scope",
          "url",
          "read"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "area": {
            "enum": [
              "nursing practice",
              "nursing education"
            ]
          },
          "issued": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_revised": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
