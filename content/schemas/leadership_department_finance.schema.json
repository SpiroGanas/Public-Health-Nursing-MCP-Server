{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/leadership_department_finance.schema.json",
  "title": "Health department budget analysis content",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "fiscal_year",
    "definitions",
    "phe_program",
    "revenue_groups",
    "personnel_words",
    "revenue_type_words",
    "expense_type_words",
    "blocked_header_words",
    "column_aliases",
    "defaults",
    "per_capita_benchmarks",
    "not_verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "leadership-department-finance"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "docsource": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_opt": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "label",
        "value",
        "unit",
        "basis",
        "source",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "tool_default",
            "source",
            "computed"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "item_detail": {
      "type": "object",
      "required": [
        "item",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/docsource"
      }
    },
    "fiscal_year": {
      "type": "object",
      "required": [
        "default_start_month",
        "default_start_day",
        "statements"
      ],
      "additionalProperties": false,
      "properties": {
        "default_start_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "default_start_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      },
      "minItems": 1
    },
    "phe_program": {
      "type": "object",
      "required": [
        "statements",
        "label_words",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        },
        "label_words": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "revenue_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "words",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "phe",
              "federal",
              "state_other",
              "fees",
              "municipal",
              "other_grants",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "minItems": 7
    },
    "personnel_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "revenue_type_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expense_type_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "blocked_header_words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "column_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "aliases"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "category",
              "type",
              "source",
              "budget",
              "actual",
              "encumbrance",
              "account",
              "period",
              "positions"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 9
    },
    "defaults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "minItems": 3
    },
    "per_capita_benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "source",
          "section",
          "confidence",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "not_verified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item_detail"
      },
      "minItems": 1
    }
  }
}
