{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_cerc.schema.json",
  "title": "Crisis and emergency risk communication (CERC)",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "phases",
    "throughout",
    "pitfalls",
    "psychology",
    "message_map",
    "absolutes",
    "negatives",
    "initial_statement",
    "spokesperson",
    "media_questions",
    "audiences",
    "audience_reminders",
    "library"
  ],
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-cerc"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "docsource": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "text",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "key_message": {
      "type": "object",
      "required": [
        "text",
        "supporting"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "supporting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        }
      }
    },
    "faq": {
      "type": "object",
      "required": [
        "question",
        "answer",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "phase_notes": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "preparation": {
          "type": "string"
        },
        "initial": {
          "type": "string"
        },
        "maintenance": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/docsource"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "aliases",
          "tasks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "preparation",
              "initial",
              "maintenance",
              "resolution"
            ]
          },
          "label": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cited"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 4
    },
    "throughout": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      },
      "minItems": 1
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      },
      "minItems": 1
    },
    "psychology": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      },
      "minItems": 1
    },
    "message_map": {
      "type": "object",
      "required": [
        "key_messages",
        "supporting_per_key",
        "max_key_words_total",
        "max_seconds",
        "words_per_second",
        "max_average_sentence_words",
        "spokesperson_key_point_words",
        "spokesperson_key_point_seconds",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "key_messages": {
          "type": "integer",
          "minimum": 1
        },
        "supporting_per_key": {
          "type": "integer",
          "minimum": 1
        },
        "max_key_words_total": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "words_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_average_sentence_words": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spokesperson_key_point_words": {
          "type": "integer",
          "minimum": 1
        },
        "spokesperson_key_point_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 1
        }
      }
    },
    "absolutes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "initial_statement": {
      "type": "object",
      "required": [
        "elements",
        "media_holding_lines",
        "first_48_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        },
        "media_holding_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        },
        "first_48_hours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        }
      }
    },
    "spokesperson": {
      "type": "object",
      "required": [
        "tips",
        "bridges",
        "bridges_source"
      ],
      "additionalProperties": false,
      "properties": {
        "tips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          },
          "minItems": 1
        },
        "bridges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "bridges_source": {
          "type": "string"
        }
      }
    },
    "media_questions": {
      "type": "object",
      "required": [
        "source",
        "section",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "concerns",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "concerns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      },
      "minItems": 1
    },
    "audience_reminders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      },
      "minItems": 1
    },
    "library": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "aliases",
          "hazard_refs",
          "placeholders",
          "question",
          "empathy",
          "key_messages",
          "actions",
          "faqs",
          "audiences",
          "phase_notes",
          "related_tools",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hazard_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "empathy": {
            "type": "string"
          },
          "key_messages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/key_message"
            },
            "minItems": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "faqs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/faq"
            }
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phase_notes": {
            "$ref": "#/$defs/phase_notes"
          },
          "related_tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
