{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/policy_public_health_ethics.schema.json",
  "title": "Public health ethics analysis structure",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "unread_sources",
    "process_steps",
    "kass_questions",
    "burden_categories",
    "balancing_criteria",
    "justification_conditions",
    "apha_values",
    "apha_analysis_steps",
    "decision_profiles",
    "profile_origin_note",
    "copyright_notes",
    "document"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "policy-public-health-ethics"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "unread_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "process_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "kass_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "id",
          "topic",
          "question",
          "source",
          "section",
          "confidence",
          "prompts",
          "facts_to_gather"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts_to_gather": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "burden_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "note",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "balancing_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "justification_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "question",
          "text",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "apha_values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "prompt",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "apha_analysis_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "decision_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "keywords",
          "tensions",
          "facts_to_gather",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts_to_gather": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "level",
                "option",
                "burden_prompts"
              ],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "option": {
                  "type": "string"
                },
                "burden_prompts": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "profile_origin_note": {
      "type": "string"
    },
    "copyright_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "filename",
        "intro",
        "sections_before",
        "sections_after"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "sections_before": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "prompts"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sections_after": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "prompts"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
