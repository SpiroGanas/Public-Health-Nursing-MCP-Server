{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/documentation_templates.schema.json",
  "title": "Nursing documentation templates and required elements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "sources",
    "standards",
    "formats",
    "visit_types",
    "elements"
  ],
  "$defs": {
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "nursing-documentation-templates"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string"
          }
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "basis",
          "confidence",
          "sections"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "soap",
              "dar",
              "narrative"
            ]
          },
          "label": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "heading",
                "aliases",
                "prompt"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "prompt": {
                  "type": "string"
                }
              }
            },
            "minItems": 3
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "visit_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "prompts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "home_visit",
              "clinic",
              "case_investigation",
              "dot_visit"
            ]
          },
          "label": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 4
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "applies_to",
          "detector",
          "cues",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "enum": [
                "home_visit",
                "clinic",
                "case_investigation",
                "dot_visit"
              ]
            },
            "minItems": 1
          },
          "detector": {
            "enum": [
              "cues",
              "date_time",
              "credential"
            ]
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      },
      "minItems": 10
    }
  }
}