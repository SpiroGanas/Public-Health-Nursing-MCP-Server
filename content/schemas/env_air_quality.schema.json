{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_air_quality.schema.json",
  "title": "Air Quality Index categories and protective actions",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "categories",
    "breakpoints",
    "breakpoint_source",
    "breakpoint_section",
    "pm25_change",
    "sensitive_groups",
    "actions",
    "tips"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-air-quality"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "min",
          "max",
          "color",
          "rgb",
          "health_concern"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "good",
              "moderate",
              "usg",
              "unhealthy",
              "very_unhealthy",
              "hazardous"
            ]
          },
          "name": {
            "type": "string"
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          },
          "rgb": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "health_concern": {
            "$ref": "#/$defs/cited"
          }
        }
      }
    },
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pollutant",
          "averaging",
          "unit",
          "truncate_decimals",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "pollutant": {
            "type": "string"
          },
          "averaging": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "truncate_decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "breakpoint_source": {
      "type": "string"
    },
    "breakpoint_section": {
      "type": "string"
    },
    "pm25_change": {
      "$ref": "#/$defs/cited"
    },
    "sensitive_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pollutant",
          "groups",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "pollutant": {
            "type": "string"
          },
          "groups": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audience",
          "category",
          "text",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "audience": {
            "enum": [
              "general_public",
              "sensitive_groups",
              "schools",
              "outdoor_events"
            ]
          },
          "category": {
            "enum": [
              "good",
              "moderate",
              "usg",
              "unhealthy",
              "very_unhealthy",
              "hazardous"
            ]
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "tips": {
      "$ref": "#/$defs/cited_list"
    }
  }
}
