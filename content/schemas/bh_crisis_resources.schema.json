{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/bh_crisis_resources.schema.json",
  "title": "Crisis lines",
  "type": "object",
  "required": ["meta", "sources", "lines", "warmlines", "cbhc_services"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    },
    "cited_text": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "bh-crisis-resources"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "effective_date", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "effective_date": {"type": ["string", "null"]},
          "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "audience", "purpose", "contacts", "languages", "hours", "cost", "notes", "source", "section", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "audience": {"enum": ["all", "youth", "adult"]},
          "purpose": {"type": "string"},
          "contacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["mode", "value"],
              "additionalProperties": false,
              "properties": {
                "mode": {"enum": ["call", "text", "chat", "web"]},
                "value": {"type": "string"},
                "note": {"type": "string"}
              }
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["language", "how"],
              "additionalProperties": false,
              "properties": {"language": {"type": "string"}, "how": {"type": "string"}}
            }
          },
          "hours": {"type": "string"},
          "cost": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "section": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "warmlines": {
      "type": "object",
      "required": ["status", "text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["verified", "not_verified"]},
        "text": {"type": "string"},
        "source": {"type": "string"},
        "section": {"type": "string"}
      }
    },
    "cbhc_services": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}}
  }
}
