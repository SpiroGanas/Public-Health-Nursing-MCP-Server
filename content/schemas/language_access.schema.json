{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/language_access.schema.json",
  "title": "Language access thresholds and rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "safe_harbor",
    "regulations",
    "data_limits"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "safe_harbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "citation",
        "confidence",
        "threshold_percent",
        "threshold_count",
        "rule",
        "small_group_rule",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "threshold_count": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "type": "string"
        },
        "small_group_rule": {
          "type": "string"
        },
        "limits": {
          "type": "string"
        }
      }
    },
    "regulations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "citation",
          "effective_date",
          "confidence",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "data_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "confidence",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_due": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string"
              }
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  }
}
