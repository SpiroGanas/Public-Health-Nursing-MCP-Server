{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/mch_newborn.schema.json",
  "title": "Newborn and postpartum home visit guidance",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "feeding",
    "weight",
    "jaundice",
    "safe_sleep",
    "car_seat",
    "newborn_screening",
    "maternal_warning_signs"
  ],
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited_text": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited_text"
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "mch-newborn-postpartum"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "effective_date",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string"
          }
        }
      }
    },
    "feeding": {
      "type": "object",
      "required": [
        "breast",
        "formula",
        "all"
      ],
      "additionalProperties": false,
      "properties": {
        "breast": {
          "$ref": "#/$defs/cited_list"
        },
        "formula": {
          "$ref": "#/$defs/cited_list"
        },
        "all": {
          "$ref": "#/$defs/cited_list"
        }
      }
    },
    "weight": {
      "$ref": "#/$defs/cited_text"
    },
    "jaundice": {
      "$ref": "#/$defs/cited_list"
    },
    "safe_sleep": {
      "$ref": "#/$defs/cited_list"
    },
    "car_seat": {
      "$ref": "#/$defs/cited_list"
    },
    "newborn_screening": {
      "$ref": "#/$defs/cited_list"
    },
    "maternal_warning_signs": {
      "type": "object",
      "required": [
        "intro",
        "source",
        "section",
        "signs"
      ],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "signs": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": [
              "sign",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "sign": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
