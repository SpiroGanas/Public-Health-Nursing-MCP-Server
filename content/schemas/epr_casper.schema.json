{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_casper.schema.json",
  "title": "CASPER design and materials",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "design",
    "analysis",
    "consent_elements",
    "consent_template",
    "consent_template_note",
    "questionnaire",
    "team",
    "supplies",
    "interview_tips",
    "tracking_categories",
    "tracking_note",
    "team_tracking_columns",
    "referral_fields"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-casper"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "design": {
      "type": "object",
      "required": [
        "clusters",
        "interviews_per_cluster",
        "goal",
        "minimum_completion_rate",
        "minimum_cell_observations",
        "stage1",
        "stage2",
        "stage2_source",
        "stage2_section"
      ],
      "additionalProperties": false,
      "properties": {
        "clusters": {
          "type": "integer"
        },
        "interviews_per_cluster": {
          "type": "integer"
        },
        "goal": {
          "type": "integer"
        },
        "minimum_completion_rate": {
          "type": "number"
        },
        "minimum_cell_observations": {
          "type": "integer"
        },
        "stage1": {
          "$ref": "#/$defs/cited_list"
        },
        "stage2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage2_source": {
          "type": "string"
        },
        "stage2_section": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "weight_formula",
        "rules",
        "response_rates",
        "response_source",
        "response_section"
      ],
      "additionalProperties": false,
      "properties": {
        "weight_formula": {
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/cited_list"
        },
        "response_rates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "formula"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              }
            }
          }
        },
        "response_source": {
          "type": "string"
        },
        "response_section": {
          "type": "string"
        }
      }
    },
    "consent_elements": {
      "type": "object",
      "required": [
        "source",
        "section",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "consent_template": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_template_note": {
      "type": "string"
    },
    "questionnaire": {
      "$ref": "#/$defs/cited_list"
    },
    "team": {
      "$ref": "#/$defs/cited_list"
    },
    "supplies": {
      "type": "object",
      "required": [
        "source",
        "section",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interview_tips": {
      "type": "object",
      "required": [
        "source",
        "section",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tracking_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "outcomes"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tracking_note": {
      "type": "string"
    },
    "team_tracking_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referral_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
