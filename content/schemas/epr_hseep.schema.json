{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/epr_hseep.schema.json",
  "title": "HSEEP doctrine and templates",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "exercise_types",
    "documents",
    "planning_meetings",
    "planning_timeline_note",
    "smart_objective",
    "smart_corrective_action",
    "capability_elements",
    "capability_elements_source",
    "ratings",
    "ratings_source",
    "participant_roles",
    "participant_roles_source",
    "exercise_guidelines",
    "exercise_guidelines_source",
    "facilitator_tips",
    "facilitator_tips_source",
    "evaluation_questions",
    "root_cause_questions",
    "evaluation_source",
    "observation_categories",
    "observation_categories_source",
    "aar_rules",
    "after_action_timeline",
    "feedback_form",
    "msel_columns",
    "msel_source",
    "hotwash_agenda",
    "hotwash_note"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "text_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "cite_ref": {
      "type": "object",
      "required": [
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "epr-hseep"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "exercise_types": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "definition",
          "purpose",
          "default_hours",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "seminar",
              "workshop",
              "tabletop",
              "game",
              "drill",
              "functional",
              "full_scale"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "discussion",
              "operations"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 20
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "default_hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 24
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "categories",
          "distribution",
          "description",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "discussion",
                "operations"
              ]
            }
          },
          "distribution": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "planning_meetings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "operations_only",
          "weeks_before_discussion",
          "weeks_before_operations",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 10
          },
          "operations_only": {
            "type": "boolean"
          },
          "weeks_before_discussion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "weeks_before_operations": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "planning_timeline_note": {
      "type": "string",
      "minLength": 1
    },
    "smart_objective": {
      "type": "object",
      "required": [
        "guidance",
        "example",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "guidance": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "letter",
              "name",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "letter": {
                "enum": [
                  "S",
                  "M",
                  "A",
                  "R",
                  "T"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "smart_corrective_action": {
      "type": "object",
      "required": [
        "example",
        "guiding_questions",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "example": {
          "type": "string",
          "minLength": 1
        },
        "guiding_questions": {
          "$ref": "#/$defs/text_list"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "capability_elements": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "planning",
              "organization",
              "equipment",
              "training",
              "exercise"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_elements_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "ratings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "P",
              "S",
              "M",
              "U"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "ratings_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "participant_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "participant_roles_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "exercise_guidelines": {
      "$ref": "#/$defs/text_list"
    },
    "exercise_guidelines_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "facilitator_tips": {
      "$ref": "#/$defs/text_list"
    },
    "facilitator_tips_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "evaluation_questions": {
      "$ref": "#/$defs/text_list"
    },
    "root_cause_questions": {
      "$ref": "#/$defs/text_list"
    },
    "evaluation_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "observation_categories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "strength",
              "area_for_improvement"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observation_categories_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "aar_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "after_action_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "when",
          "source",
          "section",
          "tool_default"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "tool_default": {
            "type": "boolean"
          }
        }
      }
    },
    "feedback_form": {
      "type": "object",
      "required": [
        "scale",
        "factors",
        "open_questions",
        "roles",
        "source",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "keywords"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "open_questions": {
          "$ref": "#/$defs/text_list"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      }
    },
    "msel_columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "msel_source": {
      "$ref": "#/$defs/cite_ref"
    },
    "hotwash_agenda": {
      "$ref": "#/$defs/text_list"
    },
    "hotwash_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
