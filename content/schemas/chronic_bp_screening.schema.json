{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/chronic_bp_screening.schema.json",
  "title": "Community blood pressure screening kit",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "guideline_note",
    "categories",
    "pregnancy",
    "severe_range_wording",
    "referral_tiers",
    "referral_status_values",
    "technique",
    "reading_rules",
    "log_template",
    "letters",
    "handout",
    "notices"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "chronic-bp-screening"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "letter": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "markdown"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "markdown": {
          "type": "string",
          "minLength": 50
        }
      }
    },
    "handout": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sources",
        "markdown"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markdown": {
          "type": "string",
          "minLength": 50
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "guideline_note": {
      "type": "string",
      "minLength": 20
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "systolic",
          "diastolic",
          "meaning",
          "plain",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "normal",
              "elevated",
              "stage1",
              "stage2",
              "severe"
            ]
          },
          "label": {
            "type": "string"
          },
          "systolic": {
            "type": "string"
          },
          "diastolic": {
            "type": "string"
          },
          "meaning": {
            "type": "string",
            "minLength": 10
          },
          "plain": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "pregnancy": {
      "type": "object",
      "required": [
        "note",
        "high_systolic",
        "high_diastolic",
        "severe_systolic",
        "severe_diastolic",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 20
        },
        "high_systolic": {
          "type": "integer"
        },
        "high_diastolic": {
          "type": "integer"
        },
        "severe_systolic": {
          "type": "integer"
        },
        "severe_diastolic": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "severe_range_wording": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "referral_tiers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "applies_to",
          "action",
          "status",
          "confidence",
          "log_value"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "emergency",
              "same_day",
              "refer",
              "advise",
              "inform"
            ]
          },
          "applies_to": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "minLength": 10
          },
          "symptoms_note": {
            "type": "string"
          },
          "status": {
            "const": "tool default, pending review"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "log_value": {
            "type": "string"
          }
        }
      }
    },
    "referral_status_values": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "technique": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "group",
          "text",
          "source",
          "section",
          "confidence",
          "verified"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "reading_rules": {
      "type": "object",
      "required": [
        "average_note",
        "plausible_systolic",
        "plausible_diastolic"
      ],
      "additionalProperties": false,
      "properties": {
        "average_note": {
          "type": "string",
          "minLength": 20
        },
        "plausible_systolic": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "plausible_diastolic": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "log_template": {
      "type": "object",
      "required": [
        "title",
        "instructions",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "group"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "group": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "letters": {
      "type": "object",
      "required": [
        "placeholders",
        "routine",
        "refer",
        "urgent"
      ],
      "additionalProperties": false,
      "properties": {
        "placeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routine": {
          "$ref": "#/$defs/letter"
        },
        "refer": {
          "$ref": "#/$defs/letter"
        },
        "urgent": {
          "$ref": "#/$defs/letter"
        }
      }
    },
    "handout": {
      "$ref": "#/$defs/handout"
    },
    "notices": {
      "type": "object",
      "required": [
        "decision_support",
        "copyright"
      ],
      "additionalProperties": false,
      "properties": {
        "decision_support": {
          "type": "string",
          "minLength": 20
        },
        "copyright": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
