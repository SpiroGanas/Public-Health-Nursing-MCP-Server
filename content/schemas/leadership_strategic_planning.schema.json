{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/leadership_strategic_planning.schema.json",
  "title": "Strategic planning scaffolding",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "phab_requirements",
    "swot",
    "soar",
    "stakeholder",
    "plan",
    "chip_link",
    "checks",
    "checks_note",
    "not_verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "leadership-strategic-planning"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "phab_requirements": {
      "type": "object",
      "required": [
        "status",
        "statement",
        "read_in_sources",
        "to_check_in_phab_document"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "statement": {
          "type": "string"
        },
        "read_in_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          }
        },
        "to_check_in_phab_document": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "swot": {
      "type": "object",
      "required": [
        "description",
        "support",
        "support_confidence",
        "quadrants",
        "tows_prompts",
        "tows_note"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "support": {
          "type": "string"
        },
        "support_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "quadrants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "location",
              "prompts"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tows_prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        },
        "tows_note": {
          "type": "string"
        }
      }
    },
    "soar": {
      "type": "object",
      "required": [
        "description",
        "support",
        "support_confidence",
        "quadrants"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "support": {
          "type": "string"
        },
        "support_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "quadrants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "prompts"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "stakeholder": {
      "type": "object",
      "required": [
        "support",
        "support_confidence",
        "scale",
        "high_threshold",
        "threshold_note",
        "quadrants",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "support": {
          "type": "string"
        },
        "support_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "scale": {
          "type": "string"
        },
        "high_threshold": {
          "type": "number"
        },
        "threshold_note": {
          "type": "string"
        },
        "quadrants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "power",
              "interest",
              "approach"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "power": {
                "enum": [
                  "high",
                  "low"
                ]
              },
              "interest": {
                "enum": [
                  "high",
                  "low"
                ]
              },
              "approach": {
                "type": "string"
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "hierarchy_note",
        "layers",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "hierarchy_note": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "definition"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "guidance",
              "basis",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        }
      }
    },
    "chip_link": {
      "type": "object",
      "required": [
        "description",
        "cha_content_id",
        "where_chip_falls_note"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "cha_content_id": {
          "type": "string"
        },
        "where_chip_falls_note": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "checks_note": {
      "type": "string"
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
