{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/env_drinking_water.schema.json",
  "title": "Drinking water standards, resident actions, and private well testing",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "thresholds",
    "pfas_rules",
    "lead_copper_rules",
    "public_water_actions",
    "pfas_actions",
    "lead_actions",
    "private_wells",
    "tool_defaults",
    "links"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "env-drinking-water"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "cited_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "source",
          "section",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "pfas_rules": {
      "$ref": "#/$defs/cited_list"
    },
    "lead_copper_rules": {
      "$ref": "#/$defs/cited_list"
    },
    "public_water_actions": {
      "$ref": "#/$defs/cited_list"
    },
    "pfas_actions": {
      "$ref": "#/$defs/cited_list"
    },
    "lead_actions": {
      "$ref": "#/$defs/cited_list"
    },
    "private_wells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "annual",
        "every_ten_years",
        "pfas",
        "more_often",
        "arsenic_uranium",
        "bedrock_lead"
      ],
      "properties": {
        "overview": {
          "$ref": "#/$defs/cited_list"
        },
        "annual": {
          "$ref": "#/$defs/cited_list"
        },
        "every_ten_years": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "source",
            "confidence",
            "note",
            "parameters"
          ],
          "properties": {
            "section": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "note": {
              "type": "string"
            },
            "parameters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parameter",
                  "limit"
                ],
                "properties": {
                  "parameter": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "pfas": {
          "$ref": "#/$defs/cited_list"
        },
        "more_often": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "source",
            "confidence",
            "items"
          ],
          "properties": {
            "section": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "arsenic_uranium": {
          "type": "object",
          "required": [
            "text",
            "source",
            "section",
            "confidence",
            "towns"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "towns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "bedrock_lead": {
          "type": "object",
          "required": [
            "text",
            "source",
            "section",
            "confidence",
            "towns"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "towns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "tool_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "well_reliance_share",
        "default_years",
        "max_years"
      ],
      "properties": {
        "well_reliance_share": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "note"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "note": {
              "type": "string"
            }
          }
        },
        "default_years": {
          "type": "integer",
          "minimum": 1
        },
        "max_years": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
