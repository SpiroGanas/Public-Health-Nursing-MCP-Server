{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/cdsi_supporting_data.schema.json",
  "title": "CDSi supporting data, logic specification, and test cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "supporting_data",
    "logic_specification",
    "test_cases",
    "results_report",
    "known_exceptions",
    "engine_choices",
    "limitations"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "supporting_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "published",
        "download_url",
        "download_sha256",
        "retrieved",
        "embedded_files",
        "manifest",
        "license",
        "confidence"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "published": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "page_updated": {
          "type": "string",
          "format": "date"
        },
        "download_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "download_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "embedded_files": {
          "type": "integer",
          "minimum": 1
        },
        "manifest": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "logic_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "url",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suite",
          "version",
          "published",
          "sha256",
          "cases",
          "passed"
        ],
        "properties": {
          "suite": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cases": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "results_report": {
      "type": "string"
    },
    "known_exceptions": {
      "type": "string"
    },
    "engine_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "choice",
          "confidence"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "review_due": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string"
              }
            }
          }
        },
        "verification_note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  }
}
