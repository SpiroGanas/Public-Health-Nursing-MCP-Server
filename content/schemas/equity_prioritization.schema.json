{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/equity_prioritization.schema.json",
  "title": "Prioritization methods for community health issues",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "method_notes",
    "hanlon",
    "nominal_group",
    "strategy_grid",
    "not_verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "equity-prioritization"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "cited": {
      "type": "object",
      "required": [
        "text",
        "source",
        "section",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "method_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cited"
      }
    },
    "hanlon": {
      "type": "object",
      "required": [
        "formula",
        "formula_source",
        "formula_section",
        "formula_confidence",
        "divisor_note",
        "components",
        "seriousness_factors",
        "seriousness_factors_note",
        "pearl",
        "pearl_note",
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "formula": {
          "type": "string"
        },
        "formula_source": {
          "type": "string"
        },
        "formula_section": {
          "type": "string"
        },
        "formula_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "divisor_note": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "min",
              "max",
              "question",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "question": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "seriousness_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "max",
              "question",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "max": {
                "type": "number"
              },
              "question": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "seriousness_factors_note": {
          "type": "string"
        },
        "pearl": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "question",
              "source",
              "section",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "pearl_note": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "formula",
              "implemented",
              "note",
              "source",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "implemented": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        }
      }
    },
    "nominal_group": {
      "type": "object",
      "required": [
        "steps",
        "scoring_text",
        "scoring_confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cited"
          }
        },
        "scoring_text": {
          "type": "string"
        },
        "scoring_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "strategy_grid": {
      "type": "object",
      "required": [
        "text",
        "confidence",
        "source",
        "section",
        "quadrants"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "quadrants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "important",
              "feasible",
              "advice"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "important": {
                "type": "boolean"
              },
              "feasible": {
                "type": "boolean"
              },
              "advice": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
