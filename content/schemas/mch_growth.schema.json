{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/mch_growth.schema.json",
  "title": "Growth chart selection and interpretation",
  "type": "object",
  "required": ["meta", "sources", "chart_selection", "who_cut_points", "cdc_cut_points", "bmi_categories", "extended_bmi", "extreme_values", "corrected_age", "measurement_notes"],
  "additionalProperties": false,
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "cited_text": {
      "type": "object",
      "required": ["text", "source", "section"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "cut_points": {
      "type": "object",
      "required": ["low_percentile", "high_percentile", "text", "source", "section", "confidence"],
      "additionalProperties": false,
      "properties": {
        "low_percentile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 50},
        "high_percentile": {"type": "number", "exclusiveMinimum": 50, "exclusiveMaximum": 100},
        "text": {"type": "string"},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "citation": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "version", "prepared", "effective_date", "source", "related_sources", "review", "verification_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "mch-growth-interpretation"},
        "title": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "prepared": {"type": "string"},
        "effective_date": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/citation"},
        "related_sources": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "review": {
          "type": "object",
          "required": ["status", "reviewed_by", "reviewed_on", "review_due"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "reviewed"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"]},
            "review_due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "verification_note": {"type": "string", "minLength": 20}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "url", "effective_date", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "effective_date": {"type": ["string", "null"]},
          "retrieved": {"type": "string"}
        }
      }
    },
    "chart_selection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cited_text"}},
    "who_cut_points": {"$ref": "#/$defs/cut_points"},
    "cdc_cut_points": {"$ref": "#/$defs/cut_points"},
    "bmi_categories": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["category", "label", "rule", "source", "section"],
        "additionalProperties": false,
        "properties": {
          "category": {"enum": ["underweight", "healthy_weight", "overweight", "obesity", "severe_obesity", "severe_obesity_class3"]},
          "label": {"type": "string"},
          "rule": {"type": "string"},
          "source": {"type": "string"},
          "section": {"type": "string"}
        }
      }
    },
    "extended_bmi": {
      "type": "object",
      "required": ["sigma_male", "sigma_female", "text", "source", "section", "confidence"],
      "additionalProperties": false,
      "properties": {
        "sigma_male": {"type": "string"},
        "sigma_female": {"type": "string"},
        "text": {"type": "string"},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "extreme_values": {
      "type": "object",
      "required": ["who", "cdc", "cut_points"],
      "additionalProperties": false,
      "properties": {
        "who": {"$ref": "#/$defs/cited_text"},
        "cdc": {"$ref": "#/$defs/cited_text"},
        "cut_points": {
          "type": "object",
          "required": ["who_length", "who_weight", "who_other", "cdc_height", "cdc_weight", "cdc_bmi", "cdc_head"],
          "additionalProperties": false,
          "properties": {
            "who_length": {"$ref": "#/$defs/range"},
            "who_weight": {"$ref": "#/$defs/range"},
            "who_other": {"$ref": "#/$defs/range"},
            "cdc_height": {"$ref": "#/$defs/range"},
            "cdc_weight": {"$ref": "#/$defs/range"},
            "cdc_bmi": {"$ref": "#/$defs/range"},
            "cdc_head": {"$ref": "#/$defs/range"}
          }
        }
      }
    },
    "corrected_age": {
      "type": "object",
      "required": ["preterm_below_weeks", "term_weeks", "correct_until_months", "text", "source", "section", "confidence"],
      "additionalProperties": false,
      "properties": {
        "preterm_below_weeks": {"type": "number"},
        "term_weeks": {"type": "number"},
        "correct_until_months": {"type": "number"},
        "text": {"type": "string"},
        "source": {"type": "string"},
        "section": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "measurement_notes": {"type": "array", "items": {"$ref": "#/$defs/cited_text"}}
  }
}
