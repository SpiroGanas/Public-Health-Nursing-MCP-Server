{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/bh_postvention.schema.json",
  "title": "School postvention steps and templates",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "license",
    "steps",
    "talking_points",
    "templates"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "bh-school-postvention"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 20
    },
    "steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "text",
          "page"
        ],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "enum": [
              "first_24_hours",
              "first_week",
              "ongoing"
            ]
          },
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      }
    },
    "talking_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "page"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "cause_status",
          "toolkit_page",
          "markdown"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "staff_meeting",
              "student_notification",
              "parent_letter",
              "media_statement",
              "social_media_post"
            ]
          },
          "title": {
            "type": "string"
          },
          "cause_status": {
            "enum": [
              "any",
              "ruled_suicide",
              "unconfirmed",
              "family_declined_disclosure"
            ]
          },
          "toolkit_page": {
            "type": "integer"
          },
          "markdown": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
