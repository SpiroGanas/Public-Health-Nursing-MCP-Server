{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpiroGanas/Public-Health-Nursing-MCP-Server/content/schemas/policy_federal_rules_tracking.schema.json",
  "title": "Federal rule monitoring",
  "type": "object",
  "required": [
    "meta",
    "sources",
    "agencies",
    "default_agencies",
    "document_types",
    "tips",
    "outline",
    "countdown_note",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "prepared",
        "effective_date",
        "source",
        "related_sources",
        "review",
        "verification_note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "policy-federal-rules-tracking"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prepared": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/citation"
        },
        "related_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewed_by",
            "reviewed_on",
            "review_due"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_due": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "url",
        "effective_date",
        "retrieved"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "agencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "slug",
          "verified",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "label": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "verified": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      },
      "minItems": 1
    },
    "default_agencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "document_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "enum": [
              "PRORULE",
              "RULE",
              "NOTICE"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "quote",
          "paraphrase",
          "source",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "paraphrase": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "tips",
          "guidance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guidance": {
            "type": "string"
          },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^\\[NURSE: .+\\]$"
                }
              }
            }
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "type": "object",
            "required": [
              "columns",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "countdown_note": {
      "type": "string"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
